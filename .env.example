# Copy this file to `.env` and fill in real values locally.
# NEVER commit your actual `.env` file — it is already excluded via .gitignore.

# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=False

# Set to False only when running on real Raspberry Pi + Pixhawk hardware
SIMULATION_MODE=True

# MAVLink / Pixhawk
MAVLINK_CONNECTION=udp:127.0.0.1:14550
MAVLINK_BAUDRATE=57600

# Computer vision
CRACK_DETECTION_THRESHOLD=0.35

# SMTP / email automation
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
REPORT_RECIPIENT_EMAIL=
